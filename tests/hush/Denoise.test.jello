package hush;

import type { Test } from std.testing;
import std.testing as T;
import { Denoiser, denoise, frameSize, frameBytes, sampleRate } from hush.Denoise;
import { pack, unpack } from hush.Samples;

// N samples of a tone with a little noise on it, at the scale of 16-bit PCM.
let noisyTone = fn(n: I32): Array<F32> {
  let samples = Array.new<F32>(n);
  let i = 0;
  while (i < n) {
    let tone = 8000.0 * Math.sin((i as F64) * 0.05);
    let noise = 300.0 * (((i * 7919) % 23) as F64 - 11.0);
    samples[i] = (tone + noise) as F32;
    i++;
  }
  samples
};

// The PCM of N samples of silence.
let silence = fn(n: I32): Bytes { Bytes.new(n * 4).toString() };

let testFrame = fn(t: Test) {
  T.equal(t, frameSize, 480);
  T.equal(t, frameBytes, 1920);
  T.equal(t, sampleRate, 48000);
  null
};

let testOneFrame = fn(t: Test) {
  let d = new Denoiser();
  T.equal(t, d.frame(pack(noisyTone(480))).len(), frameBytes);
  d.close();
  null
};

let testWrongFrame = fn(t: Test) {
  let d = new Denoiser();
  T.throws(t, fn() { d.frame(silence(100)); null });
  T.throws(t, fn() { d.frame(silence(960)); null });
  T.throws(t, fn() { d.frame(""); null });
  null
};

let testProcessKeepsLength = fn(t: Test) {
  let d = new Denoiser();
  for (n in [0, 1, 479, 480, 481, 960, 1000]) {
    T.equal(t, d.process(silence(n)).len(), n * 4);
  }
  null
};

let testProcessRefusesPartialSample = fn(t: Test) {
  let d = new Denoiser();
  T.throws(t, fn() { d.process("abcdefg"); null });
  T.throws(t, fn() { denoise("ab"); null });
  null
};

let testProcessSamples = fn(t: Test) {
  let d = new Denoiser();
  T.equal(t, d.processSamples(noisyTone(1000)).len(), 1000);
  null
};

let testSilenceStaysSilent = fn(t: Test) {
  let d = new Denoiser();
  for (sample in unpack(d.process(silence(960)))) { T.equal(t, sample, 0.0f32); }
  null
};

// Frames processed one at a time come out as the whole processed at once.
let testFramesMatchWhole = fn(t: Test) {
  let pcm = pack(noisyTone(1440));
  let d = new Denoiser();
  let pieces = d.frame(pcm.substring(0, 1920)) + d.frame(pcm.substring(1920, 3840))
    + d.frame(pcm.substring(3840, 5760));
  T.equal(t, pieces, denoise(pcm));
  null
};

// A fresh denoiser gives the same output for the same input.
let testDeterministic = fn(t: Test) {
  let pcm = pack(noisyTone(2400));
  T.equal(t, denoise(pcm), denoise(pcm));
  null
};

// A last frame that is not whole is denoised as if silence followed it.
let testPartialFrame = fn(t: Test) {
  let tone = pack(noisyTone(700));
  let padded = denoise(tone + silence(260));
  T.equal(t, denoise(tone), padded.substring(0, tone.len()));
  null
};

let testVoiceProbability = fn(t: Test) {
  let d = new Denoiser();
  T.equal(t, d.voiceProbability(), 0.0f32);
  d.process(pack(noisyTone(4800)));
  let p = d.voiceProbability();
  T.isTrue(t, p >= 0.0f32 && p <= 1.0f32);
  null
};

let testSeparate = fn(t: Test) {
  let pcm = pack(noisyTone(960));
  let a = new Denoiser();
  let b = new Denoiser();
  a.process(pack(noisyTone(4800)));
  T.equal(t, b.process(pcm), denoise(pcm));
  null
};

let testCloseTwice = fn(t: Test) {
  let d = new Denoiser();
  d.close();
  d.close();
  null
};
