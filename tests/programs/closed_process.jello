// trap: TYPE_MISMATCH 9:1
// A denoiser does not denoise after it is closed, though the call runs on another thread.
load { denoiser_new, denoiser_close, denoiser_process } from hush;
typedef Denoiser = abstract;
let open: () -> Denoiser = denoiser_new;
let close: (Denoiser) -> Void = denoiser_close;
let process: (Denoiser, Bytes) -> Bytes = denoiser_process;
let d = open(); close(d);
process(d, "")
